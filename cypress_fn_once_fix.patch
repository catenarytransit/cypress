+/// Fetch ScyllaDB rows with bounded per-request concurrency.
+///
+/// Explicit loops avoid retaining iterator adaptor closures borrowing
+/// `ranked_ids` inside Axum handler futures (which can fail Send checking).
+/// join_all polls each batch concurrently and preserves input ordering.
+async fn fetch_places_bounded(
+    scylla_client: &ScyllaClient,
+    ranked_ids: &[(String, f64)],
+) -> Vec<Result<Option<String>>> {
+    const BATCH_SIZE: usize = 8;
+    let mut fetched = Vec::with_capacity(ranked_ids.len());
+
+    for batch in ranked_ids.chunks(BATCH_SIZE) {
+        let mut requests = Vec::with_capacity(batch.len());
+        for (id, _) in batch {
+            requests.push(scylla_client.get_place(id));
+        }
+        fetched.extend(futures::future::join_all(requests).await);
+    }
+
+    fetched
+}
